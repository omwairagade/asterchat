# Required runtime values
DATABASE_URL=mysql://user:password@host:3306/aster?ssl=%7B%22rejectUnauthorized%22%3Atrue%7D
MANUS_PROJECT_ID=your-project-id
MANUS_JWT_SECRET=replace-with-a-long-random-secret
MANUS_OAUTH_PORTAL_URL=https://your-manus-oauth-portal
MANUS_OAUTH_API_URL=https://your-manus-oauth-api
MANUS_API_URL=https://your-manus-ai-api
MANUS_API_KEY=your-manus-api-key

# Optional local development defaults
PUBLIC_APP_ORIGINS=https://asterchat.example
